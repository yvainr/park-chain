# Local-only deployment variables. Do not commit real values and do not add the private key to Vercel.
SEPOLIA_RPC_URL=https://your-sepolia-rpc-url
SEPOLIA_PRIVATE_KEY=0xyour_deployer_private_key

# Optional: reuse an existing ParkChainRouter and update the implementation addresses it stores.
# ROUTER_ADDRESS=0xYourExistingSepoliaRouter
